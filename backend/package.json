{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch --type-check",
		"start:debug": "nest start --debug --watch --type-check",
		"start:prod": "node dist/main.js",
		"lint": "biome check --no-errors-on-unmatched",
		"lint:fix": "biome check --write --no-errors-on-unmatched",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"typecheck": "tsc --noEmit",
		"typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
		"migration:generate": "npm run typeorm -- migration:generate src/database/migrations/Migration",
		"migration:create": "typeorm-ts-node-commonjs migration:create src/database/migrations/Migration",
		"migration:run": "npm run typeorm -- migration:run",
		"migration:revert": "npm run typeorm -- migration:revert",
		"db:backfill": "ts-node src/database/backfill.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1127.0",
		"@aws-sdk/lib-storage": "^3.1127.0",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/typeorm": "^12.0.1",
		"cron": "^4.4.0",
		"nestjs-pino": "^4.6.1",
		"openai": "^7.4.0",
		"pg": "^8.23.0",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.31",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.11.0",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/express": "^5.0.0",
		"@types/multer": "^2.2.0",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.0.0",
		"@vitest/coverage-v8": "^3.2.4",
		"chokidar": "^5.0.0",
		"globals": "^17.0.0",
		"lint-staged": "^17.2.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"unplugin-swc": "^1.5.1",
		"vitest": "^3.2.4"
	}
}
