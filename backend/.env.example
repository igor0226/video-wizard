PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=video-streaming
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_WORKSPACE_ROOT=/tmp/video-streaming-workspace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_streaming
# Max explanation clips rendered in parallel per video (default 3)
CLIP_GENERATION_CONCURRENCY=3
VIDEO_PROCESSING_CRON_ENABLED=true
VIDEO_PROCESSOR_CRON="*/15 * * * * *"
# Required for Whisper transcription, phrase detection, and explanation TTS
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
